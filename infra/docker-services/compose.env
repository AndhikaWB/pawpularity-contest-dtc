# Variables set here will be used by the compose services
# The root .env file may need to match some of these values

# -----

# There are several S3 services having their own variables
# So I just made my own variables as a common ground
_S3_USERNAME="admin"
_S3_PASSWORD="admin123"
_S3_ENDPOINT="http://juicefs:9000"

# AWS CLI will create these buckets
_MLFLOW_MODEL_BUCKET_NAME="mlflow"
_LAKEFS_DATA_BUCKET_NAME="lakefs"

# Use own variables to possibly support multiple PostgreSQL servers
# So that each server can have separate password if needed
_POSTGRES_ADMIN_USERNAME="postgres"
_POSTGRES_ADMIN_PASSWORD="postgres123"

# Required encryption key for some services
_MLFLOW_SUPER_KEY="mlflowthebest"
_LAKEFS_SUPER_KEY="lakefsthebest"

# Must be the same as "init/lakefs.sql"
_DB_LAKEFS_DBNAME="lakefs"
_DB_LAKEFS_USERNAME="lakefs"
_DB_LAKEFS_PASSWORD="lakefs123"

# Must be the same as "init/prefect.sql"
_DB_PREFECT_DBNAME="prefect"
_DB_PREFECT_USERNAME="prefect"
_DB_PREFECT_PASSWORD="prefect123"

# Auth for Prefect server and worker
_PREFECT_AUTH_USERNAME="prefect"
_PREFECT_AUTH_PASSWORD="prefect123"